{
  "name": "@bookcafe/app",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vue-tsc -p tsconfig.json --noEmit && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "sidecar:prepare": "pnpm --dir ../.. -r --filter @bookcafe/config --filter @bookcafe/contracts --filter @bookcafe/core --filter @bookcafe/db --filter @bookcafe/format-adapters --filter @bookcafe/scanner --filter @bookcafe/ui build && pnpm --dir ../.. --filter @bookcafe/web generate && pnpm --dir ../.. --filter @bookcafe/server build && pnpm --dir ../.. --filter @bookcafe/server copy-web",
    "sidecar:build": "pnpm sidecar:prepare && node scripts/build-sidecar.mjs",
    "notarize:build": "zsh scripts/notarize-build.zsh",
    "tauri": "tauri",
    "tauri:dev": "pnpm sidecar:build && tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bookcafe/config": "workspace:*",
    "@bookcafe/contracts": "workspace:*",
    "@bookcafe/ui": "workspace:*",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^6.0.3",
    "@yao-pkg/pkg": "^6.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.0.14",
    "vue-tsc": "^3.1.4"
  }
}
