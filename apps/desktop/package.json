{
  "name": "@bunkobank/app",
  "version": "2.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vue-tsc -p tsconfig.json --noEmit && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "sidecar:prepare": "pnpm --dir ../.. -r --filter @bunkobank/config --filter @bunkobank/contracts --filter @bunkobank/core --filter @bunkobank/db --filter @bunkobank/format-adapters --filter @bunkobank/scanner --filter @bunkobank/ui build && pnpm --dir ../.. --filter @bunkobank/web generate && pnpm --dir ../.. --filter @bunkobank/server build && pnpm --dir ../.. --filter @bunkobank/server copy-web",
    "sidecar:build": "pnpm sidecar:prepare && node scripts/build-sidecar.mjs",
    "notarize:build": "zsh scripts/notarize-build.zsh",
    "tauri": "tauri",
    "tauri:dev": "pnpm sidecar:build && tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bunkobank/config": "workspace:*",
    "@bunkobank/contracts": "workspace:*",
    "@bunkobank/ui": "workspace:*",
    "@element-plus/icons-vue": "^2.3.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "dayjs": "^1.11.21",
    "element-plus": "^2.14.4",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^6.0.3",
    "@yao-pkg/pkg": "^6.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.1.4"
  }
}
