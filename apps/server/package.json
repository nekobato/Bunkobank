{
  "name": "@bookcafe/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": "dist/main.js",
  "pkg": {
    "assets": [
      "public/**/*",
      "node_modules/better-sqlite3/build/Release/*.node",
      "node_modules/hono/dist/**/*.js",
      "node_modules/@hono/node-server/dist/**/*",
      "node_modules/@img/sharp-*/**/*",
      "node_modules/@napi-rs/canvas-*/**/*",
      "node_modules/@better-auth/utils/dist/**/*",
      "node_modules/better-call/dist/**/*",
      "node_modules/libarchive-wasm/dist/libarchive.wasm",
      "node_modules/pdfjs-dist/cmaps/**/*",
      "node_modules/pdfjs-dist/iccs/**/*",
      "node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs",
      "node_modules/pdfjs-dist/standard_fonts/**/*",
      "node_modules/pdfjs-dist/wasm/**/*"
    ]
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "copy-web": "node scripts/copy-web.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bookcafe/config": "workspace:*",
    "@bookcafe/contracts": "workspace:*",
    "@bookcafe/core": "workspace:*",
    "@bookcafe/db": "workspace:*",
    "@bookcafe/format-adapters": "workspace:*",
    "@bookcafe/scanner": "workspace:*",
    "@hono/node-server": "^2.0.10",
    "@hono/zod-validator": "^0.7.5",
    "better-auth": "^1.6.23",
    "better-sqlite3": "^12.4.6",
    "hono": "^4.12.28",
    "p-queue": "^9.3.1",
    "sharp": "^0.35.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "fflate": "^0.8.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
