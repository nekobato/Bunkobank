{
  "name": "bunkobank",
  "version": "2.0.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @bunkobank/server --filter @bunkobank/web dev",
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm --filter @bunkobank/app build && pnpm --filter @bunkobank/web generate && pnpm --filter @bunkobank/server build && pnpm --filter @bunkobank/server copy-web",
    "test": "pnpm -r --filter \"./packages/*\" build && pnpm -r --if-present test",
    "verify:bec1-interop": "pnpm --filter @bunkobank/encrypted-container build && node packages/encrypted-container/scripts/verify-rust-interop.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --filter \"./packages/*\" build && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.1",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.6",
    "vitest": "^4.0.14",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.8"
  }
}
