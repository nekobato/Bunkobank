{
  "name": "bookcafe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @bookcafe/server --filter @bookcafe/web dev",
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm --filter @bookcafe/app build && pnpm --filter @bookcafe/web generate && pnpm --filter @bookcafe/server build && pnpm --filter @bookcafe/server copy-web",
    "test": "pnpm -r --if-present test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --filter \"./packages/*\" build && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.1",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.14",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.8"
  }
}
